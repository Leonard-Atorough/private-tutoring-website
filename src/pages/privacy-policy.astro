---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Privacy Policy | Kaili Stacey Tutoring"
  description="Privacy policy for Kaili Stacey Tutoring."
>
  <main class="main-content">
    <section class="section-container" aria-label="Privacy policy">
      <h1 class="title">Privacy Policy</h1>
      <p class="content">
        This website is committed to protecting the privacy of every visitor. Personal information
        collected through the contact form will be used only to respond to your enquiry and provide
        tutoring information.
      </p>
      <p class="content">
        Information may be stored securely and will not be sold, shared, or distributed without your
        consent, except where required by law.
      </p>
      <p class="content">
        If you contact us, you may request access to or correction of the personal information we
        hold about you at any time.
      </p>
      <a class="button -secondary" href="/">Back to home</a>
    </section>
  </main>
</Layout>

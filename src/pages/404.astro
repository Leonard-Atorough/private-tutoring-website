---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page Not Found | Kaili Stacey Tutoring"
  description="The page you were looking for does not exist."
>
  <main
    class="main-content"
    style="display:grid; place-items:center; min-height:80vh; text-align:center;"
  >
    <section class="section-container" aria-label="404 page">
      <h1 class="title">Page not found</h1>
      <p class="subtitle">The page you requested is unavailable or may have moved.</p>
      <a class="button -primary" href="/">Return home</a>
    </section>
  </main>
</Layout>

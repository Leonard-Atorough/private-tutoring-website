---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ServicesOverview from "../components/ServicesOverview.astro";
import BookingModal from "../components/BookingModal.astro";
---

<Layout
  title="Services | Kaili Stacey Tutoring"
  description="Tutoring services for middle school, high school and university students."
>
  <Header />
  <main class="main-content" id="Main" aria-label="Services overview">
    <section class="section-container services-page-section" aria-labelledby="services-page-title">
      <SectionHeader
        title="MY SERVICES"
        subtitle="Personalized tutoring for Maths and Science subjects"
        ariaId="services-page-title"
      />
      <ServicesOverview />
    </section>
  </main>
  <Footer />
  <BookingModal />
</Layout>

<section
  class="modal-section"
  id="booking-modal"
  aria-hidden="true"
  aria-label="booking modal"
  role="dialog"
  aria-modal="true"
>
  <div class="modal-container">
    <div class="modal-header">
      <button
        class="button modal-close"
        id="modal-close"
        type="button"
        aria-label="Close booking modal"
      >
        &times;
      </button>
    </div>

    <iframe
      src="https://calendar.google.com/calendar/appointments/schedules/AcZssZ3IBgQa1JKS_xMfgBFW_SAfnoklJVFtxmcgH2Jy8Ev06FF-ialaZUW6ED65dSc4GGTlDT7Cmb3z?gv=true"
      loading="lazy"
      title="Booking calendar"
      frameborder="0"></iframe>
  </div>
</section>

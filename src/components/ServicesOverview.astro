---
import servicesData from "../content/services.json";

const services = servicesData.panels;
---

<div class="services-overview">
  {
    services.map((service) => (
      <details class="service-panel" aria-label={service.title}>
        <summary class="service-summary-toggle">
          <span class="service-visual">
            <img src={service.image} alt={service.title} loading="lazy" />
          </span>

          <span class="service-header-copy">
            <span class="service-title">{service.title}</span>
            <span class="service-tag-group">
              {service.tags.map((tag) => (
                <span class="service-tag">{tag}</span>
              ))}
            </span>
          </span>

          <span class="service-expand-indicator" aria-hidden="true">
            +
          </span>

          <span class="service-mobile-expand-indicator" aria-hidden="true">
            View details
          </span>
        </summary>

        <div class="service-details-panel">
          <ul class="service-list">
            {service.items.map((item) => (
              <li class="service-bubble">
                <div class="service-bubble-header">
                  <span class="service-bubble-label">{item.label}</span>
                </div>
                <p class="service-summary">{item.summary}</p>
                <p class="service-description">{item.details}</p>
              </li>
            ))}
          </ul>
        </div>
      </details>
    ))
  }
</div>

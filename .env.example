# Application version (semantic versioning: major.minor.patch)
# Examples: 1.0.0, 1.0.1-beta, 1.1.0-rc.1
VITE_APP_VERSION=1.0.0

# Sentry DSN for error tracking and session replay
# Get your DSN from: https://sentry.io/settings/[org-slug]/projects/[project]/client-key/
# Leave empty to disable error tracking (optional for development)
VITE_SENTRY_DSN=

# Sentry authentication token for uploading source maps
# Get from: https://sentry.io/settings/account/api/auth-tokens/
# Required for production builds to enable source map uploads
# Creates an account-level token with scope: project:releases
SENTRY_AUTH_TOKEN=

# Sentry organization and project slugs (for source map uploads)
SENTRY_ORG=
SENTRY_PROJECT=

# Deployment environment identifier
# Values: development (local), staging (test), production (live)
VITE_ENVIRONMENT=development